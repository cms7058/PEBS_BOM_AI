# ===== Production domain =====
# 前端浏览器访问地址
WEB_ORIGIN=https://your-domain.com
# 前端调用 API 的公网地址。Next.js 会在 build 阶段写入，修改后需要重建 web 镜像。
NEXT_PUBLIC_API_BASE=https://api.your-domain.com
# 后端 CORS 白名单，多个地址用英文逗号分隔。
API_CORS_ORIGINS=https://your-domain.com

# ===== LLM Provider =====
LLM_PROVIDER=minimaxPlan
LLM_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192
MINIMAX_PLAN_API_KEY=replace-with-real-key
MINIMAX_PLAN_BASE_URL=https://api.minimaxi.com/anthropic
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Database =====
POSTGRES_USER=pebs
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=pebs_bom
DATABASE_URL=postgresql+asyncpg://pebs:replace-with-strong-postgres-password@postgres:5432/pebs_bom
DB_AUTO_CREATE=false

# ===== Deployment / Tenancy =====
# 云服务器版用 cloud + multi；私有化单客户生产可改为 private + single。
DEPLOYMENT_MODE=cloud
TENANT_MODE=multi
DEFAULT_TENANT_ID=default

# ===== Storage / MinIO =====
STORAGE_BACKEND=minio
MINIO_ENDPOINT=minio:9000
MINIO_ROOT_USER=replace-with-minio-admin
MINIO_ROOT_PASSWORD=replace-with-strong-minio-password
MINIO_BUCKET=pebs-bom
MINIO_SECURE=false

# ===== Internal beta =====
INTERNAL_BETA_ENABLED=true
INTERNAL_BETA_VERIFY_URL=https://fc-mp-ad17509f-ebae-4693-974b-769771dd93c5.next.bspapp.com/pebs-copilot-api
INTERNAL_BETA_DURATION_DAYS=14
INTERNAL_BETA_BOM_IMPORT_LIMIT=10
INTERNAL_BETA_BOM_EXPORT_LIMIT=10
