# ===== LLM Provider =====
LLM_PROVIDER=minimaxPlan
LLM_MODEL=MiniMax-M2.7
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=8192

# ===== MiniMax Token Plan (Anthropic-compatible) =====
# 获取 Key: https://platform.minimaxi.com/user-center/basic-information/interface-key
# ↑ 选 "Token Plan 专区" 的 Key，不是按量付费
MINIMAX_PLAN_API_KEY=
MINIMAX_PLAN_BASE_URL=https://api.minimaxi.com/anthropic

# ===== DeepSeek (OpenAI-compatible) =====
# 获取 Key: https://platform.deepseek.com/api_keys
# DEEPSEEK_MODEL 是 DeepSeek API 实际暴露的模型 id；如果"deepseek-v4-pro"
# 不是当下最新名字（DeepSeek 偶尔改命名），改成对应的 id（如 deepseek-chat
# / deepseek-reasoner / deepseek-v3.2 …），重启后端即可。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== Database =====
# 本地原生开发 (SQLite，无需额外服务)
DATABASE_URL=sqlite+aiosqlite:///./data/app.db
# Docker / 私有化生产 / 云服务器生产：切 Postgres
# DATABASE_URL=postgresql+asyncpg://pebs:pebs_dev_pw@postgres:5432/pebs_bom
# 本地开发可保持 true；生产建议 false，并运行 Alembic migration
DB_AUTO_CREATE=true

# ===== Deployment / Tenancy =====
# private: 客户私有化部署，默认单租户
# cloud: PEBS 云服务器版，后续可切多租户
DEPLOYMENT_MODE=private
# single: 使用 DEFAULT_TENANT_ID；multi: 预留云版认证解析租户
TENANT_MODE=single
DEFAULT_TENANT_ID=default

# ===== Storage =====
# 本地原生：文件系统
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./data/uploads
# Docker / 生产：MinIO
# STORAGE_BACKEND=minio
# MINIO_ENDPOINT=minio:9000
# MINIO_ROOT_USER=admin
# MINIO_ROOT_PASSWORD=admin12345
# MINIO_BUCKET=pebs-bom

# ===== HTTP =====
API_CORS_ORIGINS=http://localhost:3000

# ===== Internal beta =====
INTERNAL_BETA_ENABLED=true
INTERNAL_BETA_VERIFY_URL=https://fc-mp-ad17509f-ebae-4693-974b-769771dd93c5.next.bspapp.com/pebs-copilot-api
INTERNAL_BETA_DURATION_DAYS=14
INTERNAL_BETA_BOM_IMPORT_LIMIT=10
INTERNAL_BETA_BOM_EXPORT_LIMIT=10

# ===== Frontend =====
NEXT_PUBLIC_API_BASE=http://localhost:8000
